# Manager login password for /manager (do not commit .env to Git)
# Copy this file to .env and set your real password:
# MANAGER_PASSWORD=your_secure_password

MANAGER_PASSWORD=

# WhatsApp number for "Contact us" on customer page (country code + number, no + or spaces)
# Example Israel: 972501234567
# NEXT_PUBLIC_WHATSAPP_NUMBER=972501234567
NEXT_PUBLIC_WHATSAPP_NUMBER=
